# Loading library
library(tidyverse)
library(janitor)
library(extrafont)
loadfonts(device = "win")
windowsFonts()
# Making bar chart
swine_text <- "~90% of the acres of corn planted in feral swine occupied counties is harvested as grain." %>%
str_wrap(width = 40)
no_swine_text <- "~91% of the acres of corn planted in counties not occupied by feral swine is harvested as grain." %>%
str_wrap(width = 60)
ggplot(total_crop, aes(x = swine_pres, y = sum_acres, fill = harvest_or_planted))+
geom_col(aes(x = swine_pres, y = sum_acres, fill = harvest_or_planted), position = "dodge")+
coord_flip()+
theme_minimal()+
labs(y = "Acres of Corn (Measured in Hundred Thousands)", x = "Are Swine Present?", fill = "Production \nMeasurement", title = "Corn Yield in Swine Present vs Swine Absent Counties")+
scale_fill_manual(values = c("Acres Planted" = "#3b8132", "Acres Harvested" = "#8bca84"))+
geom_text(aes(label = sum_acres), color = "#242525", position = position_dodge(width = .9), size = 4, hjust = -0.3)+
annotate(geom = "label",
x = "Yes",
y = 500,
label = swine_text,
hjust = "left") +
annotate(geom = "label",
x = 1.35,
y = 2750,
label = no_swine_text,
hjust = "left")+
annotate(geom = "segment",
x = 1.40,
y = 3850,
xend = 1.75,
yend =3750,
arrow = arrow(type = "closed"))+
theme(plot.title = element_text(size = 30, hjust = 0.5), text=element_text(family="serif"))
# Making bar chart
swine_text <- "~90% of the acres of corn planted in feral swine occupied counties is harvested as grain." %>%
str_wrap(width = 40)
no_swine_text <- "~91% of the acres of corn planted in counties not occupied by feral swine is harvested as grain." %>%
str_wrap(width = 60)
summary_text <- "As seen in the graph, there seems to be little difference between the precent of acres of corn harvested in counties with feral swine as opposed to those without feral swine. However, our results my be due to confounding variables, such as our lower swine-populated county sample size, which may be attributed to most of the US corn fields being located in the midwest, whereas the feral swine population is mainly concentrated in the south."
ggplot(total_crop, aes(x = swine_pres, y = sum_acres, fill = harvest_or_planted))+
geom_col(aes(x = swine_pres, y = sum_acres, fill = harvest_or_planted), position = "dodge")+
coord_flip()+
theme_minimal()+
labs(y = "Acres of Corn (Measured in Hundred Thousands)", x = "Are Swine Present?", fill = "Production \nMeasurement", title = "Corn Yield in Swine Present vs Swine Absent Counties", caption = summary_text)+
scale_fill_manual(values = c("Acres Planted" = "#3b8132", "Acres Harvested" = "#8bca84"))+
geom_text(aes(label = sum_acres), color = "#242525", position = position_dodge(width = .9), size = 4, hjust = -0.3)+
annotate(geom = "label",
x = "Yes",
y = 500,
label = swine_text,
hjust = "left") +
annotate(geom = "label",
x = 1.35,
y = 2750,
label = no_swine_text,
hjust = "left")+
annotate(geom = "segment",
x = 1.40,
y = 3850,
xend = 1.75,
yend =3750,
arrow = arrow(type = "closed"))+
theme(plot.title = element_text(size = 30, hjust = 0.5), text=element_text(family="serif"))
