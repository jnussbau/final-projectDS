@misc{usdaSite, 
  title={Feral Swine: Managing An Invasive Species},
  url={https://www.aphis.usda.gov/operational-wildlife-activities/feral-swine},
  journal={Animal and Plant Health Inspection Service},
  note = {
    This is the USDA's website for information and resources about the feral swine population. 
    The site is contains helpful general information, but lacks depth and does not gear towards an educational audience.
    It is a good starting place for our project, and contains lots of smaller issues within the problem to investigate with data.
    }
  } 

@article{bevins2014consequences,
  title={Consequences associated with the recent range expansion of nonnative feral swine},
  author={Bevins, Sarah N and Pedersen, Kerri and Lutman, Mark W and Gidlewski, Thomas and Deliberto, Thomas J},
  journal={BioScience},
  volume={64},
  number={4},
  pages={291--299},
  year={2014},
  publisher={Oxford University Press},
  note = {
  This is a discussion article that considers the effects of feral swine and the ability to manage
  those effects. It talks through ethical and practical concerns with controlling their population.
  The article is still a bit vague, but it does dive into some of the gray area topics, and shows how
  some of the procedures in place are lacking. For us, its another source to consider how the theoretical 
  conflicts with the practical. That will be important as we maybe come up with data-backed conclusions,
  remembering how evidence is also important when telling a story.
  }
}

@article{anderson2016economic,
  title={Economic estimates of feral swine damage and control in 11 US states},
  author={Anderson, Aaron and Slootmaker, Chris and Harper, Erin and Holderieath, Jason and Shwiff, Stephanie A},
  journal={Crop Protection},
  volume={89},
  pages={89--94},
  year={2016},
  publisher={Elsevier},
  note={
  This article looks into economic damages caused by the introduction of feral swine. This is important,
  as it is a topic we are looking to cover in our project, and seems to be harder to quantify, as sources
  are infrequent. On the downside, the data they use is based on a survey with n < 5000, which feels like a 
  small sample size, so there are definitely caveats to the results. For us, it is a good source and starting
  point if we would like to look into some economic factors at play.
  }
}

@article{corn2017map,
  author = {Corn, Joseph L. and Jordan, Thomas R.},
  title = {Development of the national feral swine map, 1982–2016},
  journal = {Wildlife Society Bulletin},
  volume = {41},
  number = {4},
  pages = {758-763},
  doi = {https://doi.org/10.1002/wsb.808},
  url = {https://wildlife.onlinelibrary.wiley.com/doi/abs/10.1002/wsb.808},
  eprint = {https://wildlife.onlinelibrary.wiley.com/doi/pdf/10.1002/wsb.808},
  year = {2017},
  note = {
  This article is about the mapmaking proccess for the maps the USDA publishes on feral swine range. It
  does not contain lots of in-depth information about impacts or solutions, but provides helpful context
  for how these maps were constructed and the data behind them. This could be useful to us in building
  a better idea for how the geospatial data is aggregated and displayed.
  }
}

@article{vercauteren2004feral,
  title={Feral swine impacts on agriculture and the environment},
  author={Vercauteren, Kurt},
  journal={Sheep \& Goat…},
  year={2004},
  note={
  This article focuses on the damages that feral swine cause to the environment, namely to crops and livestock.
  While it is a little older, it is interesting because it discusses feral swine as a newer problem, which is 
  different than the rest of the sources. It describes the issue as having no formal management, which is no
  longer true. For our purposes, this serves as good evidence for the history of feral swine in the US, which
  can be included for greater data context.
  }
}

@article{mcclure2015modeling,
  title={Modeling and mapping the probability of occurrence of invasive wild pigs across the contiguous United States},
  author={McClure, Meredith L and Burdett, Christopher L and Farnsworth, Matthew L and Lutman, Mark W and Theobald, David M and Riggs, Philip D and Grear, Daniel A and Miller, Ryan S},
  journal={PloS one},
  volume={10},
  number={8},
  pages={e0133771},
  year={2015},
  publisher={Public Library of Science San Francisco, CA USA},
  note={
  This study looks are using a variety of variables to predict habitats that feral swine will move into.
  One downfall of this article is that it is mostly a completed study, with the findings not super useful
  in our situation. While not necessarily full of information to use, I think this source could serve as 
  some inspiration for our project. We could build a similar model with a variety of different factors.
  }
}

@article{strickland2020wild,
  title={Wild pig damage to resources},
  author={Strickland, Bronson K and Smith, Mark D and Smith, Andrew L and Vercauteren, KC and Beasley, JC and Ditchkoff, SS and Mayer, JJ and Roloff, GJ},
  journal={Invasive wild pigs in North America: Ecology, impacts, and management},
  pages={143--174},
  year={2020},
  publisher={RC Press London},
  note={
  This is a book that talks about many different aspects of feral swine, but this chapter focuses solely
  on the damages that they cause to the environment and humans. This whole book would be a helpful source,
  to provide information on what subtopics could be covered over the course of our data project. One downfall
  is that the book is relatively long, and could be hard to read just the parts we are looking to know more
  about.
  }
}

@article{mckee2020economic,
  title={Economic estimates of invasive wild pig damage to crops in 12 US states},
  author={McKee, Sophie and Anderson, Aaron and Carlisle, Keith and Shwiff, Stephanie A},
  journal={Crop protection},
  volume={132},
  pages={105105},
  year={2020},
  publisher={Elsevier},
  note={
  This article takes a look at the economic costs that feral swine accrue across eradication, crop loss and
  other factors. It doesn't seem like this provides much else in the way of new information, but it does add
  some extra data. I think if we want to include economic factors, we should keep looking into these sources
  for estimates of future losses.
  }
}

@article{parkes2010rapid,
  title={Rapid eradication of feral pigs (Sus scrofa) from Santa Cruz Island, California},
  author={Parkes, John P and Ramsey, David SL and Macdonald, Norman and Walker, Kelvin and McKnight, Sean and Cohen, Brian S and Morrison, Scott A},
  journal={Biological Conservation},
  volume={143},
  number={3},
  pages={634--641},
  year={2010},
  publisher={Elsevier},
  note={
  This source would have to be accessed via ILL, but it seems like it would be very interesting. It
  talks about the eradication of feral swine from an island. This is an interesting source, as data
  from eradication is hard to find and aggregate. Obviously limited by just a small sample and dated
  evidence, it is one of the few examples of successful eradication of feral swine from a region. I think
  we could use this as part of something to project and propose a solution to feral swine in the US.
  }
}

@article{kilgo2023assessing,
  title={Assessing whole-sounder removal versus traditional control for reducing invasive wild pig (Sus scrofa) populations},
  author={Kilgo, John C and Vukovich, Mark and Cox, Kyle J and Larsen, Michael and Mims, Thomas T and Garabedian, James E},
  journal={Pest Management Science},
  volume={79},
  number={9},
  pages={3033--3042},
  year={2023},
  publisher={Wiley Online Library},
  note={
  This study takes a look at different methods of feral swine eradication. It proposes the hypothesis that
  whole-sounder removal is more effective than traditional trapping or hunting, by removing large groups at
  a time. This maybe doesn't offer a whole lot of usable information for our project, as the study is completed,
  but maybe this is a topic we can look more into for our study.
  }
}