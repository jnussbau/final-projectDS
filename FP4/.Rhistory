library(tidyverse)
library(sf)
load('SpatialData.RData')
tc_data <- tc_data |>
mutate(lake_dist_km = DistToLake/1000)
# View(CodeBook) to see original descriptions from tidycensus
ggplot() +
geom_sf(data = tc_data, aes(fill = HouseValueE)) +
scale_fill_gradient(low = "white", high = "purple") +
geom_sf(data = areawater, fill = "lightblue") +
labs(title = "Home value across the Twin Cities by census tract",
fill = "Median home value") +
ggthemes::theme_map() +
theme(legend.position = "right")
tc_data_csv <- st_drop_geometry(tc_data)
tc_data_csv |>
mutate(within_km = if_else(lake_dist_km < 1, "<1 km to lake", "> 1km to lake")) |>
ggplot(aes(fill = within_km, x = HouseValueE)) +
geom_density(alpha = 0.5) +
scale_fill_manual(values = c("orchid", "navy")) +
theme_minimal() +
labs(x = "Estimated home value of census tract", y = "",
fill = "", title = "Distribution of home values by proximity to lake")
#| layout-ncol: 2
#| warning: false
tc_data_csv |>
ggplot(aes(y = HouseValueE, x = lake_dist_km)) +
geom_point() +
geom_smooth(se = F, color = "maroon") +
theme_minimal() +
labs(y = "Estimated home value", x = "Distance to a lake from tract (km)",
title = "Home value against household size")
tc_data_csv |>
ggplot(aes(y = log(HouseValueE), x = lake_dist_km)) +
geom_point() +
geom_smooth(se = F, color = "maroon") +
theme_minimal() +
labs(y = "Log of estimated home value", x = "Distance to a lake from tract (km)",
title = "Home value against distance from a lake")
library(sp)
Queen <- poly2nb(tc_data, queen = TRUE)
ramsey_centroids <- st_centroid(st_geometry(tc_data), of_largest_polygon = TRUE)
nb_Q_net <- nb2lines(nb = Queen, coords = ramsey_centroids, as_sf = TRUE)
#Visualize network on the map (unfilled)
tc_data |>
ggplot() +
geom_sf(fill = "lightblue") +
geom_sf(data = nb_Q_net) +
ggthemes::theme_map()
lm_mod <- lm(HouseValueE ~ lake_dist_km, data = tc_data)
tc_data$lm_resid <- resid(lm_mod)
tc_data |>
ggplot() +
geom_sf(aes(fill = lm_resid)) +
geom_sf(data = areawater, fill = "lightblue") +
labs(fill = 'Residuals') +
scale_fill_gradient2(mid = "white", high = "red", low = "blue") +
ggthemes::theme_map() +
theme(legend.position = "right")
W <- nb2listw(Queen, style = "W") #style = 'W' gives row-normalized weights
mp <- spdep::moran.plot(tc_data$lm_resid, W, plot=FALSE)
ggplot(mp, aes(x = x, y = wx)) +
geom_point() +
geom_smooth(method= "lm" , se = FALSE) +
geom_hline(yintercept = mean(mp$wx), lty=2) +
geom_vline(xintercept = mean(mp$x), lty=2) + theme_classic() +
labs(x = 'Residuals', y = "Average Residual of Neighbors",
title = "Spatial Autocorrelation of Residuals")
local_moran <- spdep::localmoran(tc_data$lm_resid, W)
tc_data |>
bind_cols(local_moran) |>
ggplot() +
geom_sf(aes(fill = Ii)) +
labs(fill = 'Local Moran I') +
scale_fill_gradient2(mid = "white", high = "red", low = "blue") +
ggthemes::theme_map() +
theme(legend.position = "right")
tc_data |>
bind_cols(local_moran) |>
bind_cols(attr(local_moran,'quadr')) |>
mutate(mean = if_else(`Pr(z != E(Ii))` < 0.005, mean,NA)) |>
ggplot() +
geom_sf(aes(fill = mean)) +
labs(fill = 'Local Moran I Hotspots') +
scale_fill_manual(values= c('red', "blue", "purple"), na.value = 'lightgrey' ) +
ggthemes::theme_map() +
theme(legend.position = "right")
W <- nb2listw(Queen, style = "B") #style = 'B' gives binary weights
spdep::moran.test(tc_data$lm_resid, W, alternative = "two.sided", randomisation = TRUE)  # Global Moran's I, using randomization test
tc_data |>
bind_cols(local_moran) |>
bind_cols(attr(local_moran,'quadr')) |>
mutate(mean = if_else(`Pr(z != E(Ii))` < 0.005, mean,NA)) |>
ggplot() +
geom_sf(aes(fill = mean)) +
