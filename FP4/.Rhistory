library(tidyverse)
charts <- read_csv("data/clean/pitching/charts.csv") |>
mutate(time_through = as.factor(time_through),
count_cat = fct_relevel(count_cat, c("ahead", "even", "behind")),
pitch_type_cat = fct_relevel(pitch_type_cat, c("fast", "break", "off")),
pitch_type = fct_relevel(pitch_type, c("FF", "SI", "FC", "SL", "CB", "CH", "SP")),
opponent = fct_relevel(opponent, unique(opponent))) |>
mutate(across(where(is.character), as.factor))
results <- read_csv("data/clean/pitching/results.csv") |>
mutate(time_through = as.factor(time_through),
count_cat = fct_relevel(count_cat, c("ahead", "even", "behind")),
pitch_type_cat = fct_relevel(pitch_type_cat, c("fast", "break", "off")),
pitch_type = fct_relevel(pitch_type, c("FF", "SI", "FC", "SL", "CB", "CH", "SP")),
opponent = fct_relevel(opponent, unique(opponent))) |>
mutate(across(where(is.character), as.factor))
pitches <- read_csv("data/clean/pitching/pitches.csv") |>
mutate(time_through = as.factor(time_through),
count_cat = fct_relevel(count_cat, c("ahead", "even", "behind")),
pitch_type_cat = fct_relevel(pitch_type_cat, c("fast", "break", "off")),
pitch_type = fct_relevel(pitch_type, c("FF", "SI", "FC", "SL", "CB", "CH", "SP")),
opponent = fct_relevel(opponent, unique(opponent))) |>
mutate(across(where(is.character), as.factor))
stats <- read_csv("data/clean/stats.csv") |>
mutate(year = 2026) |>
rbind(read_csv("data/clean/stats25.csv") |> mutate(year = 2025))
w2B <- 1.316
w3B <- 1.575
wHR <- 1.751
w1B <- 0.993
wHBP <- 0.859
wBB <- 0.835
wOBAs <- data.frame(pa_result = levels(charts$pa_result),
post_wOBA = c(w1B, w2B, w3B, wBB, 0, wHBP, wHR, 0, 0, NA))
through_count <- function(given_count) {
results |>
left_join(pitches |>
group_by(pa_ID) |>
summarise(through = given_count %in% count) |>
select(pa_ID, through),
by = join_by(pa_ID)) |>
group_by(through) |>
summarise(PA = n(),
AB = sum(ATBAT),
BBE = sum(BATTEDBALL),
wOBA = mean(wOBA),
AVG = sum(HIT) / AB,
OBP = sum(ONBASE) / PA,
SLG = sum(TOTALBASES) / AB,
OPS = OBP + SLG,
`BB%` = 100 * (sum(BB) / PA),
`K%` = 100 * (sum(K) / PA),
`LD%` = 100 * sum(LINEDRIVE) / BBE,
`GB%` = 100 * sum(GROUNDBALL) / BBE,
`FB%` = 100 * sum(FLYBALL) / BBE,
`HH%` = 100 * sum(hard_hit, na.rm = T) / BBE
) |>
mutate(across(where(is.numeric), ~round(.x, 3))) |>
mutate(across(c(where(is.numeric), -AVG, -OBP, -SLG, -OPS, -wOBA), ~round(.x, 1))) |>
mutate(count = given_count) |>
filter(through == TRUE) |>
select(-through) |>
relocate(count)
}
count_wOBAs <- list_rbind(map(levels(charts$count), through_count)) |> select(count, wOBA)
dwobas <- charts |>
left_join(wOBAs, by = join_by(pa_result)) |>
mutate(next_count = lead(count)) |>
left_join(count_wOBAs |> rename(post_wOBA2 = wOBA), by = join_by(next_count == count)) |>
left_join(count_wOBAs |> rename(pre_wOBA = wOBA), by = join_by(count)) |>
mutate(post_wOBA = if_else(is.na(post_wOBA), post_wOBA2, post_wOBA)) |>
mutate(dwOBA = post_wOBA - pre_wOBA) |>
select(pitch_ID, dwOBA)
pitches <- left_join(pitches, dwobas, by = join_by(pitch_ID))
results_summary <- function(df) {
df |>
summarise(PA = n(),
AB = sum(ATBAT),
BBE = sum(BATTEDBALL),
wOBA = mean(wOBA),
xwOBA = mean(xwOBA),
xwOBACON = mean(xwOBACON, na.rm = T),
AVG = sum(HIT) / AB,
OBP = mean(ONBASE),
SLG = sum(TOTALBASES) / AB,
OPS = OBP + SLG,
`K%` = 100 * mean(K),
`BB%` = 100 * mean(BB),
`LD%` = 100 * sum(LINEDRIVE) / BBE,
`GB%` = 100 * sum(GROUNDBALL) / BBE,
`FB%` = 100 * sum(FLYBALL) / BBE,
`HH%` = 100 * sum(hard_hit, na.rm = T) / BBE,
runs = sum(runs),
RE24 = sum(RE24)
) |>
mutate(across(where(is.numeric), round, digits = 3)) |>
mutate(across(c(where(is.numeric), -AVG, -OBP, -SLG, -OPS, -wOBA, -xwOBA, -xwOBACON), ~round(.x, 1)))
}
pitch_summary <- function(df) {
df |>
summarise(
p = n(),
velo = mean(velo, na.rm = T),
dwOBA = round(mean(dwOBA), 3),
swstr = sum(WHIFF, na.rm = T) / p,
whiff = sum(WHIFF, na.rm = T) / sum(SWING),
strike = 1 - mean(BALL),
csw = sum(CALLEDSTRIKE | WHIFF, na.rm = T) / p,
swing = mean(SWING),
waste = mean(WASTE)
) |>
mutate(across(c(swstr, whiff, strike, csw, swing, waste), ~round(100 * .x, 1)))
}
